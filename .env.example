MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hacri_e2
SESSION_SECRET=replace-with-32-byte-random-secret
PUBLIC_BASE_URL=https://student-survey.juooa.cloud
SURVEY_ADMIN_USERNAME=survey_admin
SURVEY_ADMIN_PASSWORD=changeme
ORIENTATION_ADMIN_USERNAME=deeksha_admin
ORIENTATION_ADMIN_PASSWORD=changeme
# ── Mail ─────────────────────────────────────────────────────────────────────
# These four names are what the app reads. Hosting panels often label the same
# fields SMTP_SERVER / SMTP_EMAIL / SMTP_PASSWORD; those spellings are accepted
# as aliases, but prefer the canonical names below.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=officeofacademics@juooa.cloud
SMTP_PASS=
EMAIL_FROM=HACRI-E <officeofacademics@juooa.cloud>

# Leave true and nothing is sent — messages are written to a log file instead.
# It must be false in production or the app looks healthy while delivering
# nothing.
EMAIL_DRY_RUN=true

# A second mailbox, tried when the first refuses, times out or hits its rate
# limit. Optional: leave SMTP_FALLBACK_HOST empty and the app uses one account
# and one attempt, exactly as before. Use a genuinely separate mailbox — a
# second address on the same server does not help when the server is the thing
# that is down.
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
# Providers refuse to relay a message whose From is not one of their own
# addresses, so a fallback on a different provider sends as itself. Leave this
# empty and it sends as SMTP_FALLBACK_USER.
SMTP_FALLBACK_FROM=

# Seconds to wait on one SMTP connection before giving up and trying the next
# mailbox. Raise it only if your provider is genuinely slow to answer.
SMTP_TIMEOUT_SECONDS=30
# Courtesy pause (seconds) between messages inside a bulk send. The batch reuses
# a single SMTP connection, so this can be small. Raise it if your provider
# throttles per-second sends; lower/0 to send faster.
EMAIL_BATCH_DELAY_SECONDS=0.4
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
